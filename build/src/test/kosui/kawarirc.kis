# Fixture dictionary for the kosui suite (build/src/test/run.ps1).
#
# Keep every entry deterministic: a comma separates words, and an entry with
# several words returns one of them at random, so never write a comma in the
# value of an entry that a case evaluates. This file is ASCII only.

greet : Hello
name : world
nest : ${greet} ${name}!
key : name
x : 1
npw : a,b,c

# Entries for the regex_* cases. A pattern with parentheses must be quoted:
# a bare ( ) is the grouping syntax of the dictionary and disappears.
re_year : [0-9]{4}
re_date : "(?&re_year)-[0-9]{2}"
re_pair : "([a-z]+)=([0-9]+)"
re_digits : "(\d+)"
re_loop : "(?&re_loop)x"
